# Telegram Bot configuration
BOT_TOKEN=123456:REPLACE_WITH_YOUR_BOT_TOKEN

# Список Telegram ID администраторов (через запятую)
ADMIN_IDS=111111111,222222222

# Путь к файлу базы данных SQLite
DB_PATH=data/furniture_bot.sqlite3

# Источник данных: mock | api | html
SHOP_SOURCE=mock

# === Режим api === (REST API сайта)
SHOP_API_URL=http://localhost:8080/api/orders
SHOP_API_TOKEN=demo_shop_token

# === Режим html === (парсинг без API)
# Страница каталога товаров и опц. страница списка заказов в админке.
SHOP_CATALOG_URL=https://shop.example.com/catalog/mebel
SHOP_ORDERS_URL=https://shop.example.com/admin/orders
# Cookies для авторизации в админке: "PHPSESSID=abc; admin_session=xyz"
SHOP_COOKIES=

# Интервал синхронизации заказов с сайтом (в секундах)
SYNC_INTERVAL=60

# Уровень логирования
LOG_LEVEL=INFO

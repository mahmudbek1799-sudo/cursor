flowchart LR
    W[Вода] --> P[CIP насос]
    S[Щелочной раствор] --> P
    A[Кислотный раствор] --> P
    D[Дезинфектант] --> P
    P --> H[Подогреватель]
    H --> R1[Маршрут I: линия масла]
    H --> R2[Маршрут II: линия пахты]
    H --> R3[Маршрут III: резервуары]
    R1 --> RET[Возврат раствора]
    R2 --> RET
    R3 --> RET
    RET --> P

# Скопируйте этот файл в .env и подставьте свои значения
BOT_TOKEN=123456789:ABCDEF_PASTE_YOUR_TOKEN_HERE
# ID супер-администратора бота (числовой Telegram ID). Может вызывать /setup в группе.
OWNER_ID=0
# Путь к файлу базы данных SQLite (по умолчанию — bot.db рядом с main.py)
DB_PATH=bot.db
# Путь к файлу журнала ошибок
LOG_FILE=errors.log
